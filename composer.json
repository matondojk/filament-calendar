{
    "name": "matondojk/filament-calendar",
    "description": "Um widget de calendário interativo e responsivo para Filament PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Matondo JK",
            "email": "contato@matondojk.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0|^4.0|^5.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Matondojk\\FilamentCalendar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Matondojk\\FilamentCalendar\\FilamentCalendarServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
